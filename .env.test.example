# Copy this file to .env.test and fill in the test-only values.
# .env.test is ignored and must never be committed.

SHEET_ID=REEMPLAZAR_CON_TEST_SHEET_ID

# Optional overrides. Values not present here are loaded from .env.
LOCAL_IA_ENABLED=true
LOCAL_IA_BASE_URL=http://localhost:1234/v1
LOCAL_IA_MODEL=google_gemma-3-4b-it
LOCAL_IA_TIMEOUT_SECONDS=300

# The test spreadsheet must already contain these worksheets/tables.
SHEET_TABLE=Turnos
SHEET_EMAIL_TABLE=Correos
