# Cuenta IMAP que recibe las copias ocultas (CCO)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=planilla@midominio.com
IMAP_PASSWORD=REEMPLAZAR_CON_PASSWORD_O_APP_PASSWORD
IMAP_FOLDER=INBOX
IMAP_SEARCH=UNSEEN
# Remitentes permitidos, separados por coma. Vacío = aceptar todos.
ALLOWED_SENDERS=secretaria@midominio.com

# Cuenta SMTP usada para responder a la secretaria
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=planilla@midominio.com
SMTP_PASSWORD=REEMPLAZAR_CON_PASSWORD_O_APP_PASSWORD

# Base URL for links stored in Google Sheets.
MAIL_WEB_BASE_URL=https://mail.google.com/mail/u/0

# Carpetas donde se mueven los correos después de procesarlos
MAIL_PROCESSED_FOLDER=INBOX.Procesados
MAIL_FAILED_FOLDER=INBOX.Fallidos

# Google AI Studio (Gemini API)
GOOGLE_AI_STUDIO_API_KEY=REEMPLAZAR_CON_GOOGLE_AI_STUDIO_API_KEY
GOOGLE_AI_STUDIO_MODEL=gemini-2.0-flash

# OpenRouter fallback
OPENROUTER_API_KEY=REEMPLAZAR_CON_OPENROUTER_API_KEY
OPEN_ROUTER_MODEL=REEMPLAZAR_CON_OPENROUTER_MODEL

# Local model via LM Studio (primary provider when enabled)
LOCAL_AI_ENABLED=true
LOCAL_AI_BASE_URL=http://localhost:1234/v1
LOCAL_AI_MODEL=google_gemma-3-4b-it
LOCAL_AI_TIMEOUT_SECONDS=300

# Google Sheets: archivo JSON de la cuenta de servicio y spreadsheet ID
GOOGLE_CREDENTIALS=google-service-account.json
SHEET_ID=REEMPLAZAR_CON_GOOGLE_SHEET_ID
SHEET_TABLE=Turnos
SHEET_EMAIL_TABLE=Correos
SHEET_TAB=Turnos

# Intervalo entre consultas, expresado en minutos
INTERVAL_MINUTES=15
